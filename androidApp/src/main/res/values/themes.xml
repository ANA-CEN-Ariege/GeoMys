<resources>
    <!-- Fond de fenêtre affiché au lancement, avant le premier rendu Compose : même dégradé que
         l'écran d'accueil, pour éviter un flash blanc. -->
    <style name="Theme.GeoMysCommon" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_accueil</item>
        <!-- Couleurs des dialogues du système (DatePickerDialog et TimePickerDialog des détails du
             relevé) : colorPrimary et colorSecondary (orange) de Theme.GeoMys, qu'AppCompat recopie
             dans android:colorPrimary et android:colorAccent sous GeoMys-Android. -->
        <item name="android:colorPrimary">#FF1B6CA8</item>
        <item name="android:colorAccent">#FFFF6D00</item>
    </style>
</resources>
