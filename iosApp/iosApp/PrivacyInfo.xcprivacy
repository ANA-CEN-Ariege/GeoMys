<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Manifeste de confidentialité de l'appli, exigé par App Store Connect (ITMS-91053).

  Le framework Kotlin (GeoMysUi) est statique : Kotlin/Native, Compose, Skiko (Skia, ICU), MapLibre Native,
  Okio, Ktor et multiplatform-settings sont dans l'exécutable, et aucun n'apporte son propre manifeste.
  C'est donc celui-ci qui déclare ce qu'ils utilisent. Établi le 26 novembre 2026 d'après le binaire
  Release 2.2.1 (nm -u, otool) : à revoir quand une bibliothèque change, avec le rapport de confidentialité
  de l'archive (Organizer > Generate Privacy Report).
-->
<plist version="1.0">
<dict>
	<!-- Ni pistage ni identifiant publicitaire. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Données envoyées au serveur GeoNature choisi par l'utilisateur, pour la seule fonction de l'appli.
	     À garder d'accord avec la fiche « Confidentialité de l'app » d'App Store Connect. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Position précise des observations et des stations (la trace GPS reste sur le téléphone,
		     sauf export GPX par l'utilisateur). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePreciseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Photos jointes aux observations. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Fichiers son joints aux observations. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeAudioData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Contenu des saisies : espèces, dénombrements, commentaires, habitats, formulaires. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Identifiant de connexion et identifiant du compte (id_role) sur le serveur GeoNature. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Noms des observateurs des relevés. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- stat, fstat, lstat (Okio, Skia, ICU, MapLibre) et attributesOfItemAtPath (Fichiers.ios.kt) : taille,
		     existence et type de fichiers du conteneur de l'appli (cache, médias, cartes MBTiles, ressources,
		     fichiers choisis dans le sélecteur de documents, qui les copie dans le conteneur). -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<!-- Sélecteur systemUptime de metal-cpp (MapLibre Native), jamais appelé : déclaré par prudence, pour
		     mesurer des durées dans l'appli ; rien n'est envoyé. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
		<!-- NSUserDefaults : réglages lus et écrits par l'appli seule (suites privées gn_config, GeoMys_prefs…,
		     sans App Group ; MapLibre lit aussi standardUserDefaults). -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
