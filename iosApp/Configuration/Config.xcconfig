// Identité de l'application iOS. GeoMys est indépendante de GeoMys-IOS : son propre
// bundle id lui permet de cohabiter avec elle sur un même iPhone.
// Équipe de l'ANA (« ANA - CONSERVATOIRE D'ESPACES NATURELS ARIEGE », adhérente au programme
// développeur d'Apple) : elle publie l'appli sur l'App Store et signe aussi les versions de test.
TEAM_ID=MDLYU65243
// Comme sous Android : la configuration Release (archive pour l'App Store, mesure de TaxRef) prend
// l'identifiant de la version publiée ; le debug garde le sien et cohabite avec elle sur un iPhone.
BUNDLE_ID=fr.ariegenature.geomys.common
BUNDLE_ID[config=Release]=fr.ariegenature.geomys
// Nom du produit (fichier .app), sans espace.
APP_NAME=GeoMys
// Nom affiché sous l'icône.
APP_DISPLAY_NAME=GeoMys
MARKETING_VERSION=2.2.2
CURRENT_PROJECT_VERSION=228
// Le code Kotlin n'est compilé que pour les simulateurs Apple Silicon (iosSimulatorArm64) : sans
// cette ligne, un build pour « tout simulateur » réclame aussi x86_64.
EXCLUDED_ARCHS[sdk=iphonesimulator*]=x86_64
