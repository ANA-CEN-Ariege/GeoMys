// Identité de l'application iOS. GeoMys Common est indépendante de GeoMys-IOS : son propre
// bundle id lui permet de cohabiter avec elle sur un même iPhone.
TEAM_ID=5J5PGRYHS5
BUNDLE_ID=fr.ariegenature.geomys.common
// Nom du produit (fichier .app), sans espace.
APP_NAME=GeoMysCommon
// Nom affiché sous l'icône.
APP_DISPLAY_NAME=GeoMys Common
MARKETING_VERSION=0.3.0
CURRENT_PROJECT_VERSION=3
// Le code Kotlin n'est compilé que pour les simulateurs Apple Silicon (iosSimulatorArm64) : sans
// cette ligne, un build pour « tout simulateur » réclame aussi x86_64.
EXCLUDED_ARCHS[sdk=iphonesimulator*]=x86_64
